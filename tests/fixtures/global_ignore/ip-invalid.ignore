# #
#   Tests › GLOBAL_IGNORE › Validation › Invalid
#   
#   List of invalid basic ip firewall rules, used to test
#   LF_GLOBAL functionality.
#   
#   Before 15.11:   Malformed ports and owners passed through,
#                       invalid IP fields were ignored.
#   15.11 + later:  Malformed ports and owners rejected, 
#                       invalid IP fields are rejected.
#                       (unless valid owner is present).
#   
#   Initialized:    lfd.pl::global()
#   Tests:          lfd.pl::linefilter()
#   
#   @usage          1.  Set in /etc/csf/csf.conf:
#                           LF_GLOBAL       = "300"
#                           GLOBAL_IGNORE   = "https://raw.githubusercontent.com/Aetherinox/csf-firewall/refs/heads/main/tests/fixtures/global_ignore/ip-invalid.ignore"
#                           DEBUG           = "2"
#   
#                   2.  Restart csf:
#                           sudo csf -ra
#                       Note (does not reload lfd rules):
#                           sudo csf -sf
#   
#                   3.  Any valid rules loaded into:
#                           /var/lib/csf/csf.gignore
#
#                   4.  View debug print "LINEFILTER (Result):"
#                           /var/log/lfd.log
#   
#   @file           afr-invalid.ignore
#   
#   @warn           Do not use these as a value within
#                   /etc/csf/csf.conf for the setting GLOBAL_IGNORE
#                   unless you know what you are doing.
# #

# #
#   Invalid IPv4 addresses
# #

not-an-ip
192.0.2.999

# #
#   Invalid IPv4 CIDRs
# #

192.0.2.0/33
198.51.100.0/test

# #
#   Invalid IPv6 addresses
# #

2001:db8::gg

# #
#   Invalid IPv6 CIDRs
# #

2001:db8::/129

# #
#   Invalid advanced filtering rules
# #

tcp|out|d=22|d=198.51.100.1
tcp|out|d=22|s=198.51.100.2